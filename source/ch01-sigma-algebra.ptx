<?xml version="1.0" encoding="UTF-8"?>
<!-- Эх файл: 4sigma algD.tex (1–142-р мөр, lecture 1-sigma algebra 1.tex-тэй ижил) -->
<chapter xml:id="ch-sigma-algebra" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Алгебр ба <m>\sigma</m>-алгебр</title>

  <section xml:id="sec-algebra">
    <title>Олонлогуудын алгебр</title>

    <definition xml:id="def-family">
      <statement>
        <p><m>X</m> хоосон биш олонлог бол <m>\mathscr{P}(X)</m>-ээр түүний бүх дэд олонлогуудын бүлийг тэмдэглэе. <m>\mathscr{P}(X)</m> олонлогийн хоосон биш дэд олонлогийг <m>X</m> олонлогийн <term>дэд олонлогуудын бүл</term><idx>олонлогуудын бүл</idx> гэнэ.</p>
      </statement>
    </definition>

    <definition xml:id="def-algebra">
      <title>Алгебр</title>
      <statement>
        <p><m>X</m> олонлогийн дэд олонлогуудын бүл <m>\mathscr{A}\subset \mathscr{P}(X)</m> нь
          <ul>
            <li><p><m>(a1)</m> <m>\varnothing\in\mathscr{A}</m>, <m>X\in\mathscr{A}</m>;</p></li>
            <li><p><m>(a2)</m> <m>A, B \in \mathscr{A} \Longrightarrow A\cup B\in \mathscr{A}</m>;</p></li>
            <li><p><m>(a3)</m> <m>A\in \mathscr{A}\Longrightarrow A^c=X\setminus A\in\mathscr{A}</m></p></li>
          </ul>
        аксиомуудыг хангадаг бол <m>\mathscr{A}</m>-г <m>X</m> дээрх <term>алгебр</term><idx>алгебр</idx> гэнэ.</p>
      </statement>
    </definition>

    <example xml:id="ex-trivial-algebra">
      <p><m>X</m> хоосон биш олонлог байг. <m>\alg=\{\varnothing, X\}</m> бүл <m>X</m> дээр алгебр болно.</p>
    </example>

    <example xml:id="ex-power-set-algebra">
      <p><m>X</m> олонлог байг. <m>\mathscr{P}(X)</m> бүл <m>X</m> дээр алгебр болно.</p>
    </example>

    <proposition xml:id="prop-algebra-intersection">
      <statement>
        <p><m>X</m> хоосон биш олонлог, <m>\alg</m> түүн дээрх алгебр байг. <m>A, B\in\alg</m> бол
          <md number="yes" xml:id="eq-a3prime">A\cap B\in\alg</md>
        байна. Энэ нөхцөлийг <m>(a3')</m> гэж тэмдэглэе.</p>
      </statement>
      <proof>
        <p><m>(a2)</m> ба <m>(a3)</m> аксиомууд ёсоор
          <md>(A \cap B)^c=A^c\cup B^c\in\alg \ \Rightarrow \ A\cap B\in\alg.</md>
        </p>
      </proof>
    </proposition>

    <remark xml:id="rem-algebra-axioms">
      <p>
        <ol marker="a)">
          <li><p><m>\alg\neq\varnothing</m> гэсэн шаардлага тавивал <m>(a2)</m> ба <m>(a3)</m> аксиомуудаас <m>(a1)</m> аксиом мөрдөн гарна. Үнэндээ, <m>A\in\alg</m> олдоно. <m>(a3)</m> аксиом ёсоор <m>A^c\in\alg</m>. <m>(a2)</m> аксиом ёсоор <m>A\cup A^c=X\in\alg</m>. <m>(a3)</m> аксиом ёсоор <m>\varnothing=X^c\in\alg</m>.</p></li>
          <li><p><m>(a3)</m> ба <m>(a3')</m>-аас <m>(a2)</m> мөрдөн гарах тул <m>(a2)</m> аксиомыг <m>(a3')</m> нөхцөлөөр сольж болно.</p></li>
          <li><p>Дурын <m>n</m> натурал тооны хувьд <m>A_1, A_2, \ldots, A_n\in\mathscr{A}</m> бол
            <md>A_1\cup A_2\cup\ldots \cup A_n\in\mathscr{A}, \quad A_1\cap A_2\cap\ldots \cap A_n\in\mathscr{A}</md>
          байна.</p></li>
        </ol>
      </p>
    </remark>
  </section>

  <section xml:id="sec-sigma-algebra">
    <title><m>\sigma</m>-алгебр ба хэмжигдэх огторгуй</title>

    <definition xml:id="def-sigma-algebra">
      <title><m>\sigma</m>-алгебр</title>
      <statement>
        <p><m>X</m> олонлогийн дэд олонлогуудын бүл <m>\mathscr{A}\subset \mathscr{P}(X)</m> нь
          <ul>
            <li><p><m>(\sigma 1)</m> <m>\mathscr{A}</m> алгебр;</p></li>
            <li><p><m>(\sigma 2)</m> <m>A_1, A_2, \ldots \in\mathscr{A}\Lra\bigcup\limits_{n=1}^{\infty} A_n\in\mathscr{A}</m></p></li>
          </ul>
        нөхцөлүүдийг хангадаг бол <m>\mathscr{A}</m> бүлийг <m>X</m> дээрх <term><m>\sigma</m>-алгебр</term><idx><m>\sigma</m>-алгебр</idx> гэнэ.</p>
      </statement>
    </definition>

    <p><m>(\sigma 2)</m> аксиомыг <m>\sigma</m>-алгебрын тоологдом нэгдлийн хувьд битүү байх чанар гэдэг.</p>

    <proposition xml:id="prop-sigma-intersection">
      <statement>
        <p>Хэрэв <m>\mathscr{A}</m> нь <m>\sigma</m>-алгебр бөгөөд <m>n\in \N</m> бүрийн хувьд <m>A_n\in\mathscr{A}</m> бол
          <md>\BC{j=1}{\infty} A_j\in\mathscr{A}</md>
        байна. Энэ нөхцөлийг <m>(\sigma 2')</m> гэж тэмдэглэе. Өөрөөр хэлбэл <m>\sigma</m>-алгебр нь тоологдом огтлолцлын хувьд битүү байна.</p>
      </statement>
      <proof>
        <p><m>n\in \N</m> бүрийн хувьд <m>A_n\in\mathscr{A}</m> тул <m>(a3)</m> ба <m>(\sigma 2)</m> ёсоор
          <md>\BC{j=1}{\infty} A_j=\left(\BCD{j=1}{\infty}A_j^c\right)^c\in\mathscr{A}.</md>
        </p>
      </proof>
    </proposition>

    <remark xml:id="rem-sigma2prime">
      <p><m>(a3)</m> ба <m>(\sigma 2')</m>-аас <m>(\sigma 2)</m> мөрдөн гарах тул <m>(\sigma 2)</m> аксиомыг <m>(\sigma 2')</m> нөхцөлөөр сольж болно.</p>
    </remark>

    <definition xml:id="def-measurable-space">
      <statement>
        <p><m>X</m> хоосон биш олонлог, <m>\mathscr{A}</m> түүн дээрх <m>\sigma</m>-алгебр байг. <m>(X,\mathscr{A})</m> хосыг <term>хэмжигдэх огторгуй</term><idx>хэмжигдэх огторгуй</idx> гэх ба <m>\sigma</m>-алгебрт агуулагдах олонлогийг <term>хэмжигдэх олонлог</term><idx>хэмжигдэх олонлог</idx> гэнэ.</p>
      </statement>
    </definition>

    <example xml:id="ex-trivial-sigma">
      <p><m>X</m> хоосон биш олонлог бол
        <ul>
          <li><p><m>\{\varnothing , X\}</m> нь <m>\sigma</m>-алгебр;</p></li>
          <li><p><m>\mathscr{P}(X)</m> нь <m>\sigma</m>-алгебр.</p></li>
        </ul>
      </p>
    </example>

    <p>Мэдээж <m>\sigma</m>-алгебр бүр алгебр байна. Харин алгебр <m>\sigma</m>-алгебр байх албагүй.</p>

    <example xml:id="ex-finite-cofinite">
      <title><m>\sigma</m>-алгебр биш алгебрын жишээ</title>
      <p><m>X</m> хоосон биш олонлог байг.
        <md>\mathscr{A}=\{ A\subset X \mid A \text{ төгсгөлөг олонлог эсвэл } A^c \text{ төгсгөлөг олонлог}\}</md>
      гэе. <m>\mathscr{A}</m> нь <m>X</m> дээр алгебр болно гэж харуулъя.</p>

      <p><m>|\varnothing|=0</m> бөгөөд <m>X^c=\varnothing</m> тул <m>\varnothing, X\in\mathscr{A}</m>.</p>

      <p><m>A\in\mathscr{A}</m> байг. Эхлээд <m>A</m> төгсгөлөг гэе. <m>(A^c)^c=A</m> тул <m>A^c\in\mathscr{A}</m>. Эсрэг тохиолдолд <m>A^c</m> төгсгөлөг байх ёстой тул <m>A^c\in\mathscr{A}</m>.</p>

      <p><m>A, B\in\mathscr{A}</m> байг. Хэрэв <m>A, B</m> олонлогууд төгсгөлөг бол <m>A\cup B</m> төгсгөлөг байх тул <m>A\cup B\in\mathscr{A}</m>. Хэрэв <m>A, B</m> олонлогуудын ядаж нэг нь төгсгөлөг биш бол <m>A^c, B^c</m> олонлогуудын ядаж нэг нь төгсгөлөг байна. Тодорхой байх үүднээс <m>B^c</m> төгсгөлөг гэе.
        <md>(A\cup B)^c=A^c\cap B^c\subset B^c</md>
      тул <m>(A\cup B)^c</m> төгсгөлөг олонлог байна. Иймд <m>A\cup B\in\mathscr{A}</m> болов. Ийнхүү <m>\mathscr{A}</m> бүл алгебр болох нь батлагдлаа.</p>

      <p>Хэрэв <m>X</m> төгсгөлөг биш, тухайлбал <m>X=\R</m> бол <m>\mathscr{A}</m> бүл нь нэг ч тоологдом төгсгөлгүй олонлогийг агуулахгүй. <m>A_i=\{i\}, \ i\in \N</m> нэг элементтэй олонлогууд <m>\mathscr{A}</m> бүлийн элемент боловч тэдгээрийн нэгдэл болох
        <md>\bigcup\limits_{i=1}^{\infty}A_i=\N</md>
      натурал тоон олонлог төгсгөлөг биш бөгөөд гүйцээлт нь мөн төгсгөлөг биш тул <m>\mathscr{A}</m> бүлд харьяалагдахгүй. Иймд <m>\mathscr{A}</m> бүл <m>\sigma</m>-алгебр биш байна.</p>
    </example>

    <example xml:id="ex-countable-cocountable">
      <p><m>X</m> тоологдом биш олонлог бол
        <md>\mathscr{A}=\{ E\subset X \mid E \text{ тоологдом олонлог эсвэл } E^c \text{ тоологдом олонлог}\}</md>
      бүл <m>\sigma</m>-алгебр болох нь <xref ref="ex-finite-cofinite"/>-тэй адилаар харагдана.</p>
    </example>

    <definition xml:id="def-monotone-sequence">
      <statement>
        <p><m>\{A_i\}_{i=1}^{\infty}</m> нь <m>X</m> олонлогийн дэд олонлогуудын дараалал байг.
          <md>A_1\subset A_2\subset\ldots \subset A_n\subset\ldots</md>
        байвал уг дарааллыг <term>олонлогуудын өсөх дараалал</term><idx>олонлогуудын өсөх дараалал</idx>,
          <md>A_1\supset A_2\supset\ldots \supset A_n\supset\ldots</md>
        бол <term>олонлогуудын буурах дараалал</term><idx>олонлогуудын буурах дараалал</idx> гэнэ.</p>
      </statement>
    </definition>

    <lemma xml:id="lem-monotone-sigma">
      <statement>
        <p><m>X</m> хоосон биш олонлог, <m>\mathscr{A}</m> уг олонлог дээрх алгебр байг. Дараах хоёр нөхцөлийн ядаж нэг нь биелдэг бол <m>\mathscr{A}</m> нь <m>X</m> олонлог дээр <m>\sigma</m>-алгебр болно:
          <ol marker="a)">
            <li><p><m>\{A_i\}_{i=1}^{\infty}\subset\mathscr{A}</m> олонлогуудын өсөх дараалал бол <m>\bigcup\limits_{i=1}^{\infty}A_i\in\mathscr{A}</m>;</p></li>
            <li><p><m>\{A_i\}_{i=1}^{\infty}\subset\mathscr{A}</m> олонлогуудын буурах дараалал бол <m>\bigcap\limits_{i=1}^{\infty}A_i\in\mathscr{A}</m>.</p></li>
          </ol>
        </p>
      </statement>
      <proof>
        <p>Эхлээд <m>a)</m> нөхцөл биелж байг. <m>(\sigma2)</m> аксиомыг шалгахад хангалттай. <m>\{B_j\}_{j=1}^{\infty}\subset \mathscr{A}</m> дурын дараалал байг. <m>\{A_i\}_{i=1}^{\infty}</m> дарааллыг дараах зарчмаар байгуулъя:
          <md>A_1=B_1,\quad A_i=\bigcup\limits_{j=1}^iB_j,\quad (i=2,3,\ldots).</md>
        Ийнхүү байгуулагдсан <m>\{A_i\}_{i=1}^{\infty}</m> нь олонлогуудын өсөх дараалал бөгөөд
          <md>\bigcup\limits_{j=1}^{\infty}B_j=\bigcup\limits_{i=1}^{\infty}A_i</md>
        байх нь илт. <m>\mathscr{A}</m> бүл нь алгебр учир <m>i\in \N</m> дугаар бүрийн хувьд <m>A_i\in \mathscr{A}</m> юм. <m>a)</m> нөхцөл ёсоор <m>\mathscr{A}</m> алгебрын олонлогуудын өсөх дараалал бүрийн нэгдэл <m>\mathscr{A}</m> алгебрт харьяалагдах ёстой учир
          <md>\bigcup\limits_{j=1}^{\infty}B_j=\bigcup\limits_{i=1}^{\infty}A_i\in\mathscr{A}.</md>
        </p>
        <p><m>b)</m> нөхцөл биелж байг. <m>\{A_i\}_{i=1}^{\infty}\subset \mathscr{A}</m> олонлогуудын өсөх дараалал бол <m>A^c_i\in\mathscr{A}</m> ба <m>\{A^c_i\}_{i=1}^{\infty}\subset\mathscr{A}</m> олонлогуудын буурах дараалал байна. Иймд <m>b)</m> нөхцөлөөр
          <md>\bigcup\limits_{i=1}^{\infty}A_i=\Big( \bigcap\limits_{i=1}^{\infty}A^c_i\Big)^c\in\mathscr{A}</md>
        болж, <m>a)</m> нөхцөл биелнэ. Иймд өмнөх тохиолдол ёсоор <m>\mathscr{A}</m> нь <m>\sigma</m>-алгебр байна.</p>
      </proof>
    </lemma>
  </section>

  <section xml:id="sec-generated-sigma">
    <title>Төрөгдсөн <m>\sigma</m>-алгебр</title>

    <proposition xml:id="prop-intersection-sigma">
      <statement>
        <p><m>\mathcal{I}</m> ямар нэг индексийн олонлог ба <m>i\in\mathcal{I}</m> бүрийн хувьд <m>\mathscr{A}_i</m> нь <m>X</m> дээрх <m>\sigma</m>-алгебр бол
          <md>\bigcap\limits_{i\in\mathcal{I}}\mathscr{A}_i</md>
        <m>\sigma</m>-алгебр болно.</p>
      </statement>
      <proof>
        <p><m>i\in\mathcal{I}</m> бүрийн хувьд <m>\varnothing, X \in\mathscr{A}_i</m> тул <m>\varnothing, X \in\bigcap\limits_{i\in\mathcal{I}}\mathscr{A}_i</m> байна.</p>
        <p>Хэрэв <m>A\in\bigcap\limits_{i\in\mathcal{I}}\mathscr{A}_i</m> бол <m>i\in\mathcal{I}</m> бүрийн хувьд <m>A\in\A_i</m>, улмаар <m>A^c\in\A_i</m> тул <m>A^c\in\bigcap\limits_{i\in\mathcal{I}}\mathscr{A}_i</m> байна.</p>
        <p>Хэрэв <m>\{E_n\}_{n\in\N}\subset\bigcap\limits_{i\in\mathcal{I}}\mathscr{A}_i</m> бол <m>i\in\mathcal{I}</m> бүрийн хувьд <m>\{E_n\}_{n\in\N}\subset \mathscr{A}_i</m>, улмаар <m>\bigcup\limits_{n\in\N}E_n\in \mathscr{A}_i</m> байна. Иймд <m>\bigcup\limits_{n\in\N}E_n\in \bigcap\limits_{i\in\mathcal{I}}\mathscr{A}_i</m> болж, тоологдом нэгдлийн хувьд битүү байна.</p>
      </proof>
    </proposition>

    <proposition xml:id="prop-generated">
      <statement>
        <p><m>X</m> хоосон биш олонлог ба <m>\mathscr{E}\subset \mathscr{P}(X)</m> байг.
          <md>\mathcal{M}(\mathscr{E}):=\bigcap\{\A \mid \A \text{ нь } \mathscr{E} \text{-г агуулсан } \sigma\text{-алгебр}\}</md>
        бүл <m>\sigma</m>-алгебр болно.</p>
      </statement>
      <proof>
        <p><m>\mathscr{P}(X)</m> бүл <m>\sigma</m>-алгебр учир <m>\mathscr{E}</m> бүлийн хувьд түүнийг агуулсан <m>\sigma</m>-алгебр олдоно. <xref ref="prop-intersection-sigma"/>-аас <m>\mathcal{M}(\mathscr{E})</m> бүл нь <m>\sigma</m>-алгебр болох нь илт байна.</p>
      </proof>
    </proposition>

    <definition xml:id="def-generated">
      <statement>
        <p><m>X</m> хоосон биш олонлог ба <m>\mathscr{E}\subset \mathscr{P}(X)</m> байг.
          <md>\mathscr{E}_{\sigma}:=\bigcap\{\A \mid \A \text{ нь } \mathscr{E} \text{-г агуулсан } \sigma\text{-алгебр}\}</md>
        бүлийг <m>\mathscr{E}</m>-ээр <term>төрөгдсөн <m>\sigma</m>-алгебр</term><idx>төрөгдсөн <m>\sigma</m>-алгебр</idx> гэнэ.</p>
      </statement>
    </definition>

    <remark xml:id="rem-smallest">
      <p>Хэрэв <m>\A</m> нь <m>\mathscr{E}</m>-г агуулсан <m>\sigma</m>-алгебр бол тодорхойлолт ёсоор <m>\mathscr{E}_{\sigma}\subset \A</m> тул <m>\mathscr{E}_{\sigma}</m> нь <m>\mathscr{E}</m>-г агуулсан хамгийн бага <m>\sigma</m>-алгебр болно. (Бид энд жиших үйлдлийг агуулагдах харьцаагаар ойлгоно.)</p>
    </remark>

    <proposition xml:id="prop-generated-compare">
      <statement>
        <p><m>X</m> хоосон биш олонлог, <m>\mathscr{E}, \mathscr{F}\subset \mathscr{P}(X)</m> байг.
          <ol marker="a)">
            <li><p>Хэрэв <m>\mathscr{E}\subset \mathscr{F}_{\sigma}</m> бол <m>\mathscr{E}_{\sigma}\subset \mathscr{F}_{\sigma}</m> байна.</p></li>
            <li><p>Хэрэв <m>\mathscr{E}\subset \mathscr{F}_{\sigma}</m> ба <m>\mathscr{F}\subset \mathscr{E}_{\sigma}</m> бол <m>\mathscr{E}_{\sigma}=\mathscr{F}_{\sigma}</m> байна.</p></li>
          </ol>
        </p>
      </statement>
      <proof>
        <p>
          <ol marker="a)">
            <li><p><m>\mathscr{F}_{\sigma}</m> нь <m>\mathscr{E}</m>-г агуулсан <m>\sigma</m>-алгебр, <m>\mathscr{E}_{\sigma}</m> нь <m>\mathscr{E}</m>-г агуулсан хамгийн бага <m>\sigma</m>-алгебр тул <m>\mathscr{E}_{\sigma}\subset \mathscr{F}_{\sigma}</m> байна.</p></li>
            <li><p><m>a)</m>-г хоёр чиглэлд хэрэглэвэл мөрдөн гарна.</p></li>
          </ol>
        </p>
      </proof>
    </proposition>
  </section>

  <xi:include href="./exercises/sem-sigma-algebra.ptx"/>
  <xi:include href="./exercises/hw-sigma-algebra.ptx"/>
</chapter>
